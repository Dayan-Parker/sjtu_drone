  <!--OAKD-LITE REFERENCE-->
  <gazebo reference="oakd_lite_link">
    <sensor name="oakd_rgb_camera_sensor" type="camera">
      <pose>0.01233 -0.03 0.01878 0 0 0</pose>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <camera name="IMX214">
        <horizontal_fov>1.204</horizontal_fov>
        <image>
          <width>1920</width>
          <height>1080</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <plugin filename="libgazebo_ros_camera.so" name="oakd_rgb_camera_controller">
        <ros>
          <namespace>/simple_drone</namespace>
          <remapping>image_raw:=oakd/rgb/image_raw</remapping>
          <remapping>camera_info:=oakd/rgb/camera_info</remapping>
        </ros>
        <frame_name>oakd_lite_link</frame_name>
      </plugin>
    </sensor>
    <sensor name="oakd_depth_camera_sensor" type="depth">
      <pose>0.01233 -0.03 0.01878 0 0 0</pose>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <camera name="StereoOV7251">
        <horizontal_fov>1.274</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.2</near>
          <far>19.1</far>
        </clip>
      </camera>
      <plugin filename="libgazebo_ros_depth_camera.so" name="oakd_depth_camera_controller">
        <ros>
          <namespace>/simple_drone</namespace>
          <remapping>image_raw:=oakd/depth/image_raw</remapping>
          <remapping>camera_info:=oakd/depth/camera_info</remapping>
          <remapping>points:=oakd/depth/points</remapping>
        </ros>
        <frame_name>oakd_lite_link</frame_name>
        <point_cloud_cutoff>0.2</point_cloud_cutoff>
        <point_cloud_cutoff_max>19.1</point_cloud_cutoff_max>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="base_link">
    <sensor name="gps" type="gps">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <gps>
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </vertical>
        </position_sensing>
