    <origin rpy="0 1.570796326795 0" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="bottom_cam_link"/>
  </joint>
  <link name="bottom_cam_link"/>
  <!-- OakD-Lite link -->
  <link name="oakd_lite_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
